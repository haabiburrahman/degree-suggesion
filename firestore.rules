rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /years/{yearId} {
      allow read: if true;
      allow write: if true;
    }

    match /departments/{deptId} {
      allow read: if true;
      allow write: if true;
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if true;
    }

    match /suggestions/{suggestionId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
